        "jsCode": "const credentials = $('Set Meta Config').first().json;\nconst convTypes   = String(credentials.meta_conversion_action_types || 'lead').split(',').map(s => s.trim());\n\nconst data = items[0].json.data || [];\n\nconst dateMap = {};\nconst campaignDayMap = {};\n\nfor (const r of data) {\n  const date    = r.date_start || 'unknown';  // now a single day\n  const actions = Array.isArray(r.actions) ? r.actions : [];\n  const conv    = actions.filter(a => convTypes.includes(a.action_type)).reduce((s, a) => s + Number(a.value || 0), 0);\n  const spend   = Number(r.spend || 0);\n  const impr    = Number(r.impressions || 0);\n  const clks    = Number(r.clicks || 0);\n  const cId     = r.campaign_id   || '';\n  const cName   = r.campaign_name || 'Unknown';\n\n  if (!dateMap[date]) dateMap[date] = { spend: 0, impressions: 0, clicks: 0, conversions: 0 };\n  dateMap[date].spend       += spend;\n  dateMap[date].impressions += impr;\n  dateMap[date].clicks      += clks;\n  dateMap[date].conversions += conv;\n\n  const key = `${cId}::${date}`;\n  if (!campaignDayMap[key]) {\n    campaignDayMap[key] = { date, campaign_id: cId, campaign_name: cName, spend: 0, impressions: 0, clicks: 0, conversions: 0 };\n  }\n  campaignDayMap[key].spend       += spend;\n  campaignDayMap[key].impressions += impr;\n  campaignDayMap[key].clicks      += clks;\n  campaignDayMap[key].conversions += conv;\n}\n\nconst daily_rows = Object.entries(dateMap).map(([date, m]) => ({\n  date,\n  spend:       Number(m.spend.toFixed(2)),\n  impressions: m.impressions,\n  clicks:      m.clicks,\n  conversions: m.conversions,\n  cpl:  m.conversions > 0 ? Number((m.spend / m.conversions).toFixed(2)) : null,\n  ctr:  m.impressions > 0 ? Number((m.clicks / m.impressions * 100).toFixed(4)) : 0\n}));\n\nconst campaign_rows = Object.values(campaignDayMap).map(c => ({\n  date:          c.date,\n  campaign_id:   c.campaign_id,\n  campaign_name: c.campaign_name,\n  spend:         Number(c.spend.toFixed(2)),\n  impressions:   c.impressions,\n  clicks:        c.clicks,\n  conversions:   c.conversions,\n  cpl:  c.conversions > 0 ? Number((c.spend / c.conversions).toFixed(2)) : null,\n  ctr:  c.impressions > 0 ? Number((c.clicks / c.impressions * 100).toFixed(4)) : null\n}));\n\nconst accountName = data[0]?.account_name || 'Las Vegas';\n\nreturn [{ json: { daily_rows, campaign_rows, account_name: accountName } }];\n"
      },
