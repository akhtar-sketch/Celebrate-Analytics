    {
      "parameters": {
        "url": "https://business-api.tiktok.com/open_api/v1.3/report/integrated/get/",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "advertiser_id",
              "value": "={{ $('Set TikTok Config').item.json.advertiser_id }}"
            },
            {
              "name": "report_type",
