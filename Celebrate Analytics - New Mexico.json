      "parameters": {
        "jsCode": "const d = items[0].json;\n\nconst location_id   = 'new-mexico';\nconst location_name = d.account_name || 'New Mexico';\nconst platform      = 'google';\n\nconst daily_metrics = (d.daily_rows || []).map(row => ({\n  location_id, location_name, platform,\n  date:        row.date,\n  spend:       row.spend,\n  impressions: row.impressions,\n  clicks:      row.clicks,\n  conversions: row.conversions,\n  cpl:         row.cpl,\n  ctr:         row.ctr\n}));\n\nconst daily_campaigns = (d.campaign_rows || []).map(row => ({\n  location_id, location_name, platform,\n  date:          row.date,\n  campaign_id:   row.campaign_id,\n  campaign_name: row.campaign_name,\n  spend:         row.spend,\n  impressions:   row.impressions,\n  clicks:        row.clicks,\n  conversions:   row.conversions,\n  cpl:           row.cpl,\n  ctr:           row.ctr\n}));\n\nreturn [{ json: { daily_metrics, daily_campaigns } }];\n"
      },
