    {
      "parameters": {
        "method": "POST",
        "url": "=https://googleads.googleapis.com/{{ $json.google_api_version }}/customers/{{ $json.customer_id }}/googleAds:search",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAdsOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "developer-token",
              "value": "={{ $json.developer_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  query: `\n    SELECT\n      customer.id,\n      customer.descriptive_name,\n      campaign.id,\n      campaign.name,\n      segments.date,\n      metrics.impressions,\n      metrics.clicks,\n      metrics.cost_micros,\n      metrics.conversions\n    FROM campaign\n    WHERE segments.date BETWEEN '${$('Get Req. Dates').first().json.date_from}'\n      AND '${$('Get Req. Dates').first().json.date_to}'\n  `\n}\n}}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        16,
        592
      ],
      "id": "3e0eda45-7a74-447f-bdb3-1d3215aab774",
      "name": "SA - Get Google",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "credentials": {
        "googleAdsOAuth2Api": {
          "id": "OHWAGJdokBHrnA3Z",
          "name": "Google Ads account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = items[0].json.results || [];\n\nconst dateMap = {};\nconst campaignDayMap = {};\n\nfor (const r of results) {\n  const date  = r.segments?.date || 'unknown';\n  const cost  = Number(r.metrics?.costMicros || 0) / 1000000;\n  const impr  = Number(r.metrics?.impressions || 0);\n  const clks  = Number(r.metrics?.clicks || 0);\n  const conv  = Number(r.metrics?.conversions || 0);\n  const cId   = String(r.campaign?.id || '');\n  const cName = r.campaign?.name || 'Unknown';\n\n  if (!dateMap[date]) dateMap[date] = { spend: 0, impressions: 0, clicks: 0, conversions: 0 };\n  dateMap[date].spend       += cost;\n  dateMap[date].impressions += impr;\n  dateMap[date].clicks      += clks;\n  dateMap[date].conversions += conv;\n\n  const key = `${cId}::${date}`;\n  if (!campaignDayMap[key]) {\n    campaignDayMap[key] = { date, campaign_id: cId, campaign_name: cName, spend: 0, impressions: 0, clicks: 0, conversions: 0 };\n  }\n  campaignDayMap[key].spend       += cost;\n  campaignDayMap[key].impressions += impr;\n  campaignDayMap[key].clicks      += clks;\n  campaignDayMap[key].conversions += conv;\n}\n\nconst daily_rows = Object.entries(dateMap).map(([date, m]) => ({\n  date,\n  spend:       Number(m.spend.toFixed(2)),\n  impressions: m.impressions,\n  clicks:      m.clicks,\n  conversions: m.conversions,\n  cpl:  m.conversions > 0 ? Number((m.spend / m.conversions).toFixed(2)) : null,\n  ctr:  m.impressions > 0 ? Number((m.clicks / m.impressions * 100).toFixed(4)) : 0\n}));\n\nconst campaign_rows = Object.values(campaignDayMap).map(c => ({\n  date:          c.date,\n  campaign_id:   c.campaign_id,\n  campaign_name: c.campaign_name,\n  spend:         Number(c.spend.toFixed(2)),\n  impressions:   c.impressions,\n  clicks:        c.clicks,\n  conversions:   c.conversions,\n  cpl:  c.conversions > 0 ? Number((c.spend / c.conversions).toFixed(2)) : null,\n  ctr:  c.impressions > 0 ? Number((c.clicks / c.impressions * 100).toFixed(4)) : null\n}));\n\nconst accountName = results[0]?.customer?.descriptiveName || 'Springfield';\n\nreturn [{ json: { daily_rows, campaign_rows, account_name: accountName } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        592
      ],
      "id": "7bc5ae2e-1e09-4fb1-873b-89798dd1c2b2",
      "name": "SA - Aggregate Google"
    },
    {
      "parameters": {
        "jsCode": "const d = items[0].json;\n\nconst location_id   = 'san-antonio';\nconst location_name = d.account_name || 'San Antonio';\nconst platform      = 'google';\n\nconst daily_metrics = (d.daily_rows || []).map(row => ({\n  location_id, location_name, platform,\n  date:        row.date,\n  spend:       row.spend,\n  impressions: row.impressions,\n  clicks:      row.clicks,\n  conversions: row.conversions,\n  cpl:         row.cpl,\n  ctr:         row.ctr\n}));\n\nconst daily_campaigns = (d.campaign_rows || []).map(row => ({\n  location_id, location_name, platform,\n  date:          row.date,\n  campaign_id:   row.campaign_id,\n  campaign_name: row.campaign_name,\n  spend:         row.spend,\n  impressions:   row.impressions,\n  clicks:        row.clicks,\n  conversions:   row.conversions,\n  cpl:           row.cpl,\n  ctr:           row.ctr\n}));\n\nreturn [{ json: { daily_metrics, daily_campaigns } }];\n"
      },
